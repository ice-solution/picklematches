<%#
  大會場地編輯。locals:
  - venues (normalized)
  - showPin (default true)
  - showStream (default true)
  - streamStatuses (optional map slug -> { live, hasConfig, lastError })
  - eventId (optional, for start/stop forms)
%>
<%
  var _venues = typeof venues !== 'undefined' && venues ? venues : [];
  var _showPin = typeof showPin === 'undefined' ? true : !!showPin;
  var _showStream = typeof showStream === 'undefined' ? true : !!showStream;
  var _streamStatuses = typeof streamStatuses === 'undefined' || !streamStatuses ? {} : streamStatuses;
  var _eventId = typeof eventId !== 'undefined' ? eventId : '';
%>
<div id="venue-editor" class="space-y-3">
  <div id="venue-rows" class="space-y-4">
    <% if (!_venues.length) { %>
      <%- include('venue-editor-card', {
        v: { slug: '1', name: '1 號場', streamRtspUrl: '', youtubeRtmpServer: '', youtubeStreamKey: '' },
        showPin: _showPin,
        showStream: _showStream,
        streamStatus: null,
        eventId: _eventId,
        isTemplate: false,
      }) %>
    <% } else { %>
      <% _venues.forEach(function (v) { %>
        <%- include('venue-editor-card', {
          v: v,
          showPin: _showPin,
          showStream: _showStream,
          streamStatus: _streamStatuses[v.slug] || null,
          eventId: _eventId,
          isTemplate: false,
        }) %>
      <% }); %>
    <% } %>
  </div>
  <button type="button" id="venue-add" class="rounded border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:bg-slate-800">＋ 新增場地</button>
  <p class="text-xs text-slate-500">
    ID 用於網址，例如 Live：<code class="rounded bg-slate-800 px-1">/e/…/court/1/live</code>。
    PIN 供場地工作人員登入計分。
    <% if (_showStream) { %>直播設定儲存後，可用「開播／停播」把該場鏡頭推去 YouTube（計分板疊右上角）。<% } %>
  </p>
</div>
<template id="venue-row-tpl">
  <%- include('venue-editor-card', {
    v: { slug: '', name: '', streamRtspUrl: '', youtubeRtmpServer: '', youtubeStreamKey: '' },
    showPin: _showPin,
    showStream: _showStream,
    streamStatus: null,
    eventId: '',
    isTemplate: true,
  }) %>
</template>
<script>
  (function () {
    var list = document.getElementById('venue-rows');
    var tpl = document.getElementById('venue-row-tpl');
    var addBtn = document.getElementById('venue-add');
    if (!list || !tpl || !addBtn) return;

    function bindRemove(card) {
      var btn = card.querySelector('.venue-remove');
      if (!btn) return;
      btn.addEventListener('click', function () {
        if (list.querySelectorAll('.venue-card').length <= 1) {
          card.querySelectorAll('input').forEach(function (inp) {
            if (inp.name === 'venueYoutubeKey' || inp.name === 'venuePin') inp.value = '';
            else if (inp.name === 'venueSlug' || inp.name === 'venueName') { /* keep */ }
            else inp.value = '';
          });
          return;
        }
        card.remove();
      });
    }

    list.querySelectorAll('.venue-card').forEach(bindRemove);

    addBtn.addEventListener('click', function () {
      var node = tpl.content.cloneNode(true);
      list.appendChild(node);
      var card = list.lastElementChild;
      bindRemove(card);
      var n = list.querySelectorAll('.venue-card').length;
      var slug = card.querySelector('[name="venueSlug"]');
      var name = card.querySelector('[name="venueName"]');
      if (slug && !slug.value) slug.value = String(n);
      if (name && !name.value) name.value = String(n) + ' 號場';
    });
  })();
</script>
