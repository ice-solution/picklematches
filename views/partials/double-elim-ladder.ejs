<%#
  doubleElimTracks: { winners: [{label, matches}], losers: [...], grandFinal: [m,...] }
%>
<% if (tournament.phase === 'double_elim') { %>
<section class="double-elim-ladder mt-6 space-y-8" aria-label="雙敗淘汰雙軌籤表">
  <div>
    <h3 class="text-base font-semibold text-emerald-300">勝部（未輸過）</h3>
    <p class="mt-1 text-xs text-slate-500">勝部輸咗會跌入敗部；要輸兩場先出局。</p>
    <% if (!doubleElimTracks || !doubleElimTracks.winners || !doubleElimTracks.winners.length) { %>
      <p class="mt-3 text-sm text-slate-500">尚無勝部場次。請先加入隊伍後產生雙敗籤表。</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto pb-2">
        <div class="flex min-w-min items-stretch">
          <% doubleElimTracks.winners.forEach(function (col, idx) { %>
            <% if (idx > 0) { %>
              <div class="flex w-8 shrink-0 items-center justify-center text-slate-600" aria-hidden="true">→</div>
            <% } %>
            <div class="flex w-52 shrink-0 flex-col border border-emerald-900/50 bg-emerald-950/20 p-3">
              <div class="border-b border-emerald-800/40 pb-2 text-center text-xs font-semibold text-emerald-300"><%= col.label %></div>
              <div class="mt-3 flex flex-col gap-3">
                <% col.matches.forEach(function (m) { %>
                  <div class="rounded border border-slate-700/80 bg-slate-900/50 px-2 py-2.5 text-xs">
                    <div class="flex items-stretch gap-1">
                      <div class="flex flex-1 flex-col items-end justify-center text-right">
                        <%- include('team-display', { team: m.teamA, align: 'right', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
                      </div>
                      <div class="flex w-6 shrink-0 items-center justify-center text-[10px] text-slate-500">vs</div>
                      <div class="flex flex-1 flex-col items-start justify-center text-left">
                        <%- include('team-display', { team: m.teamB, align: 'left', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
                      </div>
                    </div>
                    <%- include('score-display', { m: m, scoreMainClass: 'mt-1 text-center font-mono text-sm font-bold text-emerald-300', scoreDetailClass: 'block text-center font-mono text-[10px] text-emerald-300/70' }) %>
                    <% if (typeof adminLinks !== 'undefined' && adminLinks) { %>
                      <a href="/admin/matches/<%= m._id %>/edit" class="mt-1.5 block text-center text-sky-400 underline">編輯</a>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <h3 class="text-base font-semibold text-amber-300">敗部（一敗）</h3>
    <p class="mt-1 text-xs text-slate-500">由勝部跌落；再輸一場即出局。</p>
    <% if (!doubleElimTracks || !doubleElimTracks.losers || !doubleElimTracks.losers.length) { %>
      <p class="mt-3 text-sm text-slate-500">尚無敗部場次（兩隊賽制可能直接入總決賽）。</p>
    <% } else { %>
      <div class="mt-4 overflow-x-auto pb-2">
        <div class="flex min-w-min items-stretch">
          <% doubleElimTracks.losers.forEach(function (col, idx) { %>
            <% if (idx > 0) { %>
              <div class="flex w-8 shrink-0 items-center justify-center text-slate-600" aria-hidden="true">→</div>
            <% } %>
            <div class="flex w-52 shrink-0 flex-col border border-amber-900/45 bg-amber-950/15 p-3">
              <div class="border-b border-amber-800/40 pb-2 text-center text-xs font-semibold text-amber-300"><%= col.label %></div>
              <div class="mt-3 flex flex-col gap-3">
                <% col.matches.forEach(function (m) { %>
                  <div class="rounded border border-slate-700/80 bg-slate-900/50 px-2 py-2.5 text-xs">
                    <div class="flex items-stretch gap-1">
                      <div class="flex flex-1 flex-col items-end justify-center text-right">
                        <%- include('team-display', { team: m.teamA, align: 'right', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
                      </div>
                      <div class="flex w-6 shrink-0 items-center justify-center text-[10px] text-slate-500">vs</div>
                      <div class="flex flex-1 flex-col items-start justify-center text-left">
                        <%- include('team-display', { team: m.teamB, align: 'left', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
                      </div>
                    </div>
                    <%- include('score-display', { m: m, scoreMainClass: 'mt-1 text-center font-mono text-sm font-bold text-amber-200', scoreDetailClass: 'block text-center font-mono text-[10px] text-amber-200/70' }) %>
                    <% if (typeof adminLinks !== 'undefined' && adminLinks) { %>
                      <a href="/admin/matches/<%= m._id %>/edit" class="mt-1.5 block text-center text-sky-400 underline">編輯</a>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <h3 class="text-base font-semibold text-sky-300">總決賽（勝部一次優勢）</h3>
    <p class="mt-1 text-xs text-slate-500">勝部冠軍（左）vs 敗部冠軍（右）。若敗部贏第一場，會再打第二場決定冠軍。</p>
    <div class="mt-4 flex flex-wrap gap-4">
      <% (doubleElimTracks && doubleElimTracks.grandFinal ? doubleElimTracks.grandFinal : []).forEach(function (m) { %>
        <% if (m.status === 'cancelled') { return; } %>
        <% var bothPh = m.teamA && m.teamA.isPlaceholder && m.teamB && m.teamB.isPlaceholder; %>
        <% if (m.grandFinalLeg === 2 && bothPh && m.status !== 'finished') { return; } %>
        <div class="w-64 rounded border border-sky-900/50 bg-sky-950/25 p-3 text-xs">
          <p class="mb-2 text-center text-xs font-semibold text-sky-300">
            <%= m.grandFinalLeg === 2 ? '總決賽第二場' : '總決賽第一場' %>
          </p>
          <div class="flex items-stretch gap-1">
            <div class="flex flex-1 flex-col items-end justify-center text-right">
              <%- include('team-display', { team: m.teamA, align: 'right', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
            </div>
            <div class="flex w-6 shrink-0 items-center justify-center text-[10px] text-slate-500">vs</div>
            <div class="flex flex-1 flex-col items-start justify-center text-left">
              <%- include('team-display', { team: m.teamB, align: 'left', primaryClass: 'font-medium text-slate-200', secondaryClass: 'block text-[10px] text-slate-500' }) %>
            </div>
          </div>
          <%- include('score-display', { m: m, scoreMainClass: 'mt-1 text-center font-mono text-sm font-bold text-sky-300', scoreDetailClass: 'block text-center font-mono text-[10px] text-sky-300/70' }) %>
          <% if (typeof adminLinks !== 'undefined' && adminLinks) { %>
            <a href="/admin/matches/<%= m._id %>/edit" class="mt-1.5 block text-center text-sky-400 underline">編輯</a>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
