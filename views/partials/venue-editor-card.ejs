<%#
  單個場地卡片。locals: v, showPin, showStream, streamStatus, eventId, isTemplate
%>
<%
  var _v = v || {};
  var _showPin = !!showPin;
  var _showStream = !!showStream;
  var _st = streamStatus || null;
  var _eventId = eventId || '';
  var _live = _st && _st.live;
%>
<div class="venue-card rounded border border-slate-800 bg-slate-950/40 p-3 sm:p-4">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <p class="text-sm font-medium text-slate-200">場地</p>
    <button type="button" class="venue-remove text-xs text-rose-400 hover:underline">移除</button>
  </div>
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div>
      <label class="block text-xs text-slate-500">ID（slug）</label>
      <input name="venueSlug" value="<%= _v.slug || '' %>" placeholder="1" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 font-mono text-sm" <%= isTemplate ? '' : 'required' %> />
    </div>
    <div class="<%= _showPin ? '' : 'sm:col-span-2' %>">
      <label class="block text-xs text-slate-500">顯示名稱</label>
      <input name="venueName" value="<%= _v.name || '' %>" placeholder="1 號場" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 text-sm" <%= isTemplate ? '' : 'required' %> />
    </div>
    <% if (_showPin) { %>
      <div>
        <label class="block text-xs text-slate-500">PIN</label>
        <input name="venuePin" type="text" inputmode="numeric" autocomplete="off" placeholder="<%= _v.pinHash ? '已設定（留空不變）' : '設定 PIN' %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 font-mono text-sm" />
      </div>
    <% } %>
  </div>

  <% if (_showStream) { %>
    <details class="mt-4 border-t border-slate-800 pt-3" <%= _live ? 'open' : '' %>>
      <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">YouTube 直播設定</p>
        <% if (_live) { %>
          <span class="rounded bg-rose-600/20 px-2 py-0.5 text-xs font-semibold text-rose-300">直播中</span>
        <% } else if (_st && _st.hasConfig) { %>
          <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-400">已設定 · 未開播</span>
        <% } else { %>
          <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-500">未設定 · 撳開編輯</span>
        <% } %>
      </summary>
      <div class="mt-3 grid gap-3">
        <div>
          <label class="block text-xs text-slate-500">鏡頭 RTSP</label>
          <input name="venueStreamRtsp" value="<%= _v.streamRtspUrl || '' %>" placeholder="rtsp://user:pass@nvr-ip:554/Streaming/Channels/101" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 font-mono text-xs sm:text-sm" />
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="block text-xs text-slate-500">YouTube RTMP 伺服器</label>
            <input name="venueYoutubeRtmp" value="<%= _v.youtubeRtmpServer || '' %>" placeholder="rtmp://a.rtmp.youtube.com/live2" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 font-mono text-xs sm:text-sm" />
          </div>
          <div>
            <label class="block text-xs text-slate-500">串流金鑰</label>
            <input name="venueYoutubeKey" type="password" autocomplete="new-password" placeholder="<%= _v.youtubeStreamKey ? '已設定（留空不變；填 - 清除）' : '貼上 YouTube 串流金鑰' %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2 py-1.5 font-mono text-xs sm:text-sm" />
          </div>
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-500">RTMP 伺服器留空則用預設 <code class="rounded bg-slate-800 px-1">rtmp://a.rtmp.youtube.com/live2</code>。串流金鑰留空＝不變；填 <code class="rounded bg-slate-800 px-1">-</code> 清除。</p>
    </details>
  <% } %>
</div>
