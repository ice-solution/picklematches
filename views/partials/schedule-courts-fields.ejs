<%-
  /* 產生賽程：勾選要用嘅場地
     預期 locals: event（或 venues）
  */
%>
<%
  var _venues = [];
  if (typeof venues !== 'undefined' && venues && venues.length) {
    _venues = venues;
  } else if (event && typeof normalizeEventVenues === 'function') {
    _venues = normalizeEventVenues(event.venues);
  } else if (event && event.venues) {
    _venues = event.venues;
  }
%>
<% if (_venues.length) { %>
  <div class="mt-3">
    <p class="text-xs font-medium text-slate-400">今次用邊幾個場（可少過大會場地）</p>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
      <% _venues.forEach(function (v) {
        var slug = (v && v.slug) ? v.slug : v;
        var label = (v && v.name) ? v.name : slug;
      %>
        <label class="inline-flex items-center gap-2 text-sm text-slate-300">
          <input type="checkbox" name="courts" value="<%= slug %>" checked class="rounded border-slate-600 bg-slate-900 text-emerald-500 focus:ring-emerald-500/40" />
          <span><%= label %><% if (v && v.slug) { %> <span class="font-mono text-[11px] text-slate-500">（<%= v.slug %>）</span><% } %></span>
        </label>
      <% }); %>
    </div>
    <p class="mt-1.5 text-[11px] text-slate-500">只會喺勾選嘅場並行排時間／場次。例如大會有 4 場，呢個組別只勾 3 個即可。</p>
  </div>
<% } %>
