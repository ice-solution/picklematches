<%- include('../partials/public-page-start', { title }) %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white sm:text-3xl">開場</h1>
        <p class="mt-2 text-sm text-slate-400">球友發起的練習或約戰，歡迎報名參加。</p>
      </div>
      <a href="/sessions/new" class="home-btn">我要開場</a>
    </div>

    <% if (!sessions.length) { %>
      <p class="home-card mt-8 text-center text-slate-400">暫無開放中的場次。<a href="/sessions/new" class="text-emerald-400 underline">成為第一個開場的人</a></p>
    <% } else { %>
      <ul class="mt-8 space-y-4">
        <% sessions.forEach(function (s) { %>
          <li class="home-card">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <a href="/sessions/<%= s._id %>" class="text-lg font-semibold text-white hover:text-emerald-300"><%= s.title %></a>
                <p class="mt-1 text-sm text-slate-400">
                  <%= s.sessionDate ? new Date(s.sessionDate).toLocaleString('zh-HK') : '—' %>
                  <% if (s.venue) { %> · <%= s.venue %><% } %>
                </p>
                <p class="mt-2 text-xs text-slate-500">
                  <%= s.formatLabel %> · <%= s.skillLabel %>
                  · 主辦：<a href="<%= s.host && s.host.profileSlug ? '/players/' + s.host.profileSlug : '#' %>" class="text-sky-400 underline"><%= s.host ? s.host.name : '—' %></a>
                </p>
              </div>
              <div class="text-right">
                <span class="text-sm font-mono text-emerald-400"><%= s.participantCount %>/<%= s.maxPlayers %></span>
                <span class="ml-2 rounded px-2 py-0.5 text-xs <%= s.status === 'open' ? 'bg-emerald-950 text-emerald-300' : 'bg-slate-800 text-slate-400' %>"><%= s.status === 'open' ? '報名中' : '已滿' %></span>
              </div>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
<%- include('../partials/public-page-end') %>
