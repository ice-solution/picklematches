<%- include('../partials/head', { title }) %>
<body class="home-page">
  <header class="home-header">
    <div class="home-container flex flex-wrap items-center justify-between gap-3 py-4">
      <a href="/member" class="text-emerald-400 underline">← 會員中心</a>
      <%- include('../partials/public-nav') %>
    </div>
  </header>
  <main class="home-container py-10">
    <h1 class="text-2xl font-bold text-white">我的資料</h1>
    <% if (saved) { %>
      <p class="mt-4 rounded border border-emerald-800/50 bg-emerald-950/30 px-4 py-3 text-sm text-emerald-200">已儲存</p>
    <% } %>
    <% if (error === 'slug') { %>
      <p class="mt-4 text-sm text-rose-400">網址代號格式不正確（小寫英文、數字、連字號）。</p>
    <% } %>
    <% if (error === 'slug_taken') { %>
      <p class="mt-4 text-sm text-rose-400">此網址代號已被使用。</p>
    <% } %>

    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="home-card lg:col-span-2">
        <h2 class="font-semibold text-emerald-400">編輯資料</h2>
        <form method="post" action="/member/profile" class="mt-4 space-y-4">
          <div>
            <label class="block text-sm text-slate-400">姓名</label>
            <input name="name" required value="<%= member.name %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm text-slate-400">公開網址代號</label>
            <div class="mt-1 flex items-center gap-1 text-sm text-slate-500">
              <span>/players/</span>
              <input name="profileSlug" value="<%= member.profileSlug || '' %>" class="flex-1 rounded border border-slate-700 bg-slate-900 px-3 py-2 font-mono" />
            </div>
          </div>
          <div>
            <label class="block text-sm text-slate-400">簡介</label>
            <textarea name="bio" rows="3" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2"><%= member.bio || '' %></textarea>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-sm text-slate-400">電話</label>
              <input name="phone" value="<%= member.phone || '' %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
            </div>
            <div>
              <label class="block text-sm text-slate-400">DUPR</label>
              <input name="duprRating" type="number" step="0.01" value="<%= member.duprRating != null ? member.duprRating : '' %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-sm text-slate-400">性別</label>
              <select name="gender" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2">
                <option value="" <%= !member.gender ? 'selected' : '' %>>—</option>
                <option value="male" <%= member.gender === 'male' ? 'selected' : '' %>>男</option>
                <option value="female" <%= member.gender === 'female' ? 'selected' : '' %>>女</option>
                <option value="other" <%= member.gender === 'other' ? 'selected' : '' %>>其他</option>
              </select>
            </div>
            <div>
              <label class="block text-sm text-slate-400">出生日期</label>
              <input name="birthDate" type="date" value="<%= member.birthDate ? new Date(member.birthDate).toISOString().slice(0,10) : '' %>" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
            </div>
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-300">
            <input type="checkbox" name="isProfilePublic" value="1" <%= member.isProfilePublic !== false ? 'checked' : '' %> />
            公開個人資料（顯示於球員列表）
          </label>
          <button type="submit" class="home-btn">儲存</button>
        </form>
      </div>

      <div class="space-y-6">
        <% if (profileUrl && member.profileSlug) { %>
          <div class="home-card text-center">
            <h2 class="font-semibold text-white">分享個人資料</h2>
            <p class="mt-2 break-all text-xs text-slate-400"><%= profileUrl %></p>
            <img
              src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=<%= encodeURIComponent(profileUrl) %>"
              alt="QR Code"
              width="180"
              height="180"
              class="mx-auto mt-4 rounded border border-slate-700 bg-white p-2"
            />
            <a href="/players/<%= member.profileSlug %>" target="_blank" rel="noopener" class="mt-4 inline-block text-sm text-emerald-400 underline">預覽公開頁 ↗</a>
          </div>
        <% } %>

        <div class="home-card">
          <h2 class="font-semibold text-emerald-400">所屬聯盟</h2>
          <% if (!alliances.length) { %>
            <p class="mt-2 text-sm text-slate-500"><a href="/member/alliances" class="underline">加入聯盟</a></p>
          <% } else { %>
            <ul class="mt-2 space-y-1 text-sm">
              <% alliances.forEach(function (a) { %>
                <li><a href="/alliances/<%= a.alliance.slug %>" class="text-sky-400 underline"><%= a.alliance.name %></a></li>
              <% }); %>
            </ul>
          <% } %>
        </div>

        <div class="home-card">
          <h2 class="font-semibold text-white">過往賽績</h2>
          <% if (!registrations.length) { %>
            <p class="mt-2 text-sm text-slate-500">暫無</p>
          <% } else { %>
            <ul class="mt-2 space-y-1 text-xs text-slate-400">
              <% registrations.slice(0, 5).forEach(function (r) { %>
                <li><%= r.event ? r.event.name : '—' %> · <%= r.division ? r.division.name : '—' %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
