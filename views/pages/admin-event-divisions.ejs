<%- include('../partials/head', { title }) %>
<%- include('../partials/admin-frame-start') %>
<main class="mx-auto w-full max-w-6xl pb-12 pt-1">
  <p class="text-sm text-slate-500">
    <a href="/admin/events/<%= event._id %>" class="text-emerald-400 underline">← <%= event.name %> 設定</a>
  </p>
  <h1 class="mt-4 text-2xl font-bold text-white">報名組別</h1>
  <p class="mt-2 text-sm text-slate-400">設定各組報名費、名額、開放／截止時間與限制條件。</p>

  <% if (flash) { %>
    <p class="mt-4 rounded border border-emerald-500/40 bg-emerald-950/30 px-3 py-2 text-sm text-emerald-200"><%= flash %></p>
  <% } %>
  <% if (error) { %>
    <p class="mt-4 rounded border border-rose-500/50 bg-rose-950/40 px-3 py-2 text-sm text-rose-200"><%= error %></p>
  <% } %>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-white">組別列表</h2>
    <div class="mt-4 overflow-x-auto rounded border border-slate-800">
      <table class="w-full min-w-[1080px] text-left text-sm">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-950/80 text-xs text-slate-500">
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">排序</th>
            <th class="px-2 py-2.5 font-medium">名稱</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">賽制</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">費用</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">名額</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">連結賽事</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">性別</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">報名開始</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">報名截止</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium">發布</th>
            <th class="whitespace-nowrap px-2 py-2.5 font-medium text-right">操作</th>
          </tr>
        </thead>
        <tbody>
          <% if (!divisions.length) { %>
            <tr>
              <td colspan="11" class="px-3 py-8 text-center text-slate-500">尚未建立組別，請於下方新增。</td>
            </tr>
          <% } %>
          <% divisions.forEach(function (d) { %>
            <tr class="border-b border-slate-800/80 align-middle">
              <form id="div-<%= d._id %>" method="post" action="/admin/divisions/<%= d._id %>/update" class="contents"></form>
              <td class="px-2 py-2 pt-6">
                <input form="div-<%= d._id %>" name="order" type="number" value="<%= d.order || 0 %>" class="w-14 rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-center text-xs" />
              </td>
              <td class="relative px-2 py-2 pt-6">
                <p class="absolute left-2 top-1.5 text-[10px] leading-none text-slate-500"><%= d.registeredCount %> 隊已報名</p>
                <input form="div-<%= d._id %>" name="name" required value="<%= d.name %>" class="w-full min-w-[7rem] rounded border border-slate-700 bg-slate-900 px-2 py-1.5 text-xs" />
              </td>
              <td class="px-2 py-2 pt-6">
                <select form="div-<%= d._id %>" name="format" class="rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs">
                  <option value="doubles" <%= d.format === 'doubles' ? 'selected' : '' %>>雙打</option>
                  <option value="singles" <%= d.format === 'singles' ? 'selected' : '' %>>單打</option>
                </select>
              </td>
              <td class="px-2 py-2 pt-6">
                <input form="div-<%= d._id %>" name="fee" type="number" min="0" step="1" value="<%= d.fee %>" class="w-16 rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs" />
              </td>
              <td class="px-2 py-2 pt-6">
                <input form="div-<%= d._id %>" name="maxTeams" type="number" min="1" value="<%= d.maxTeams %>" class="w-14 rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs" />
              </td>
              <td class="px-2 py-2 pt-6">
                <select form="div-<%= d._id %>" name="linkedTournamentId" class="max-w-[9rem] rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs" title="一對一綁定；移入報名時建隊到此賽事">
                  <option value="">— 未綁定 —</option>
                  <% (tournaments || []).forEach(function (t) { %>
                    <option value="<%= t._id %>" <%= d.linkedTournamentId === String(t._id) ? 'selected' : '' %>><%= t.name %></option>
                  <% }); %>
                </select>
              </td>
              <td class="px-2 py-2 pt-6">
                <select form="div-<%= d._id %>" name="gender" class="rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs">
                  <% [['open','開放'],['male','男子'],['female','女子'],['mixed','混雙']].forEach(function (g) { %>
                    <option value="<%= g[0] %>" <%= (d.restrictions && d.restrictions.gender) === g[0] ? 'selected' : '' %>><%= g[1] %></option>
                  <% }); %>
                </select>
              </td>
              <td class="px-2 py-2 pt-6">
                <input form="div-<%= d._id %>" name="registrationOpen" type="datetime-local" value="<%= d.registrationOpenLocal || '' %>" class="w-[11.5rem] rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs" />
              </td>
              <td class="px-2 py-2 pt-6">
                <input form="div-<%= d._id %>" name="registrationClose" type="datetime-local" value="<%= d.registrationCloseLocal || '' %>" class="w-[11.5rem] rounded border border-slate-700 bg-slate-900 px-1.5 py-1.5 text-xs" />
              </td>
              <td class="px-2 py-2 pt-6 text-center">
                <input form="div-<%= d._id %>" type="checkbox" name="isPublished" value="1" <%= d.isPublished ? 'checked' : '' %> title="前台顯示並接受報名" />
              </td>
              <td class="whitespace-nowrap px-2 py-2 pt-6 text-right">
                <button type="submit" form="div-<%= d._id %>" class="rounded bg-slate-700 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-600">儲存</button>
                <button type="submit" form="div-<%= d._id %>" formaction="/admin/divisions/<%= d._id %>/delete" formmethod="post" class="ml-1 text-xs text-rose-400 underline" onclick="return confirm('確定刪除此組別？');">刪除</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <form method="post" action="/admin/events/<%= event._id %>/divisions" class="mt-10 space-y-4 rounded border border-dashed border-slate-700 p-5">
    <h2 class="font-semibold text-slate-200">新增組別</h2>
    <p class="text-xs text-slate-500">建立時請一併填寫報名時間與限制，之後仍可於上表修改。</p>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class="block text-xs text-slate-500">組別名稱 <span class="text-rose-400">*</span></label>
        <input name="name" required placeholder="例如：男子雙打公開組" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500">賽制</label>
        <select name="format" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm">
          <option value="doubles">雙打</option>
          <option value="singles">單打</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-slate-500">排序</label>
        <input name="order" type="number" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500">報名費（HKD／每隊）</label>
        <input name="fee" type="number" min="0" step="1" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500">名額（隊）</label>
        <input name="maxTeams" type="number" min="1" value="32" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500">連結賽事（一對一）</label>
        <select name="linkedTournamentId" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm">
          <option value="">— 稍後綁定 —</option>
          <% (tournaments || []).forEach(function (t) { %>
            <option value="<%= t._id %>"><%= t.name %></option>
          <% }); %>
        </select>
        <p class="mt-1 text-[10px] text-slate-500">移入報名時會在此賽事建隊；名額須與隊數對齊。</p>
      </div>
      <div>
        <label class="block text-xs text-slate-500">性別限制</label>
        <select name="gender" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm">
          <option value="open">開放</option>
          <option value="male">男子</option>
          <option value="female">女子</option>
          <option value="mixed">混雙</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-slate-500">報名開始</label>
        <input name="registrationOpen" type="datetime-local" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-xs text-slate-500">報名截止</label>
        <input name="registrationClose" type="datetime-local" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm" />
      </div>
      <div class="flex items-end">
        <label class="flex items-center gap-2 pb-2 text-sm text-slate-300">
          <input type="checkbox" name="isPublished" value="1" checked /> 立即發布（前台可報名）
        </label>
      </div>
    </div>
    <button type="submit" class="rounded bg-emerald-600 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-500">新增組別</button>
  </form>
</main>
<%- include('../partials/admin-frame-end') %>
