<%- include('../partials/head', { title }) %>
<body class="min-h-screen bg-slate-950 text-slate-100 font-sans">
  <main class="mx-auto max-w-lg px-4 py-16">
    <h1 class="text-2xl font-bold text-emerald-400">會員註冊</h1>
    <p class="mt-2 text-sm text-slate-400">報名前請先建立帳號；雙打搭檔亦須各自註冊。</p>
    <% if (error) { %>
      <p class="mt-4 rounded border border-rose-500/50 bg-rose-950/40 px-3 py-2 text-sm text-rose-200"><%= error %></p>
    <% } %>
    <form method="post" action="/member/register" class="mt-8 space-y-4">
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>" />
      <div>
        <label class="block text-sm text-slate-400">姓名 <span class="text-rose-400">*</span></label>
        <input name="name" required class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm text-slate-400">電郵 <span class="text-rose-400">*</span></label>
        <input name="email" type="email" required class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" autocomplete="username" />
      </div>
      <div>
        <label class="block text-sm text-slate-400">密碼（至少 6 字）<span class="text-rose-400">*</span></label>
        <input name="password" type="password" required minlength="6" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" autocomplete="new-password" />
      </div>
      <div>
        <label class="block text-sm text-slate-400">電話</label>
        <input name="phone" type="tel" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-sm text-slate-400">性別</label>
          <select name="gender" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2">
            <option value="">—</option>
            <option value="male">男</option>
            <option value="female">女</option>
            <option value="other">其他</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-slate-400">出生日期</label>
          <input name="birthDate" type="date" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
        </div>
      </div>
      <div>
        <label class="block text-sm text-slate-400">DUPR 評分（手填）</label>
        <input name="duprRating" type="number" step="0.01" min="0" max="8" class="mt-1 w-full rounded border border-slate-700 bg-slate-900 px-3 py-2" />
      </div>
      <button type="submit" class="w-full rounded bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-500">註冊</button>
    </form>
    <p class="mt-6 text-center text-sm text-slate-400">
      已有帳號？<a href="/member/login<%= typeof next !== 'undefined' && next ? '?next=' + encodeURIComponent(next) : '' %>" class="text-emerald-400 underline">登入</a>
    </p>
    <p class="mt-4 text-center text-sm text-slate-500"><a class="text-emerald-400 underline" href="/">返回首頁</a></p>
  </main>
</body>
</html>
