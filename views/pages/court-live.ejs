<%- include('../partials/head', { title }) %>
<style>
  html, body { height: 100%; }
  .court-live-page {
    background: #050814;
  }
  .court-live-board {
    background: #0a0f1e;
  }
  .serve-mark {
    width: 0.85rem;
    height: 0.85rem;
    clip-path: polygon(25% 6%, 75% 6%, 100% 50%, 75% 94%, 25% 94%, 0 50%);
    background: #f8fafc;
    flex-shrink: 0;
  }
  .score-num {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }
</style>
<body class="court-live-page h-full overflow-hidden text-white antialiased">
  <div class="flex h-full items-center justify-center p-4 md:p-8">
    <div id="board" class="court-live-board w-full max-w-5xl overflow-hidden rounded-2xl border border-slate-700/80 shadow-2xl">
      <div class="border-b border-slate-800/80 px-6 py-3 text-center md:px-10">
        <p class="text-xs tracking-widest text-slate-500 uppercase"><%= event.name %></p>
        <p class="mt-0.5 text-sm text-slate-400"><%= venue.name %></p>
        <p id="roundLabel" class="mt-2 hidden text-lg font-semibold tracking-wide text-amber-300/90 md:text-xl"></p>
      </div>

      <div id="idle" class="<%= match ? 'hidden' : '' %> flex min-h-[280px] items-center justify-center px-8 py-16 text-center">
        <p class="text-2xl tracking-wide text-slate-500 md:text-3xl">等候下一場…</p>
      </div>

      <div id="active" class="<%= match ? '' : 'hidden' %>">
        <div class="divide-y divide-slate-800/80">
          <div class="flex items-center gap-4 px-6 py-6 md:px-10 md:py-9">
            <div id="serveA" class="serve-mark opacity-0" aria-hidden="true"></div>
            <div class="min-w-0 flex-1">
              <div id="teamA" class="truncate text-xl font-medium tracking-wide text-emerald-400 md:text-3xl lg:text-4xl"><%= match && match.teamA ? match.teamA.name : '' %></div>
              <div id="playersA" class="mt-2 truncate text-2xl font-semibold tracking-wide text-emerald-100 md:text-4xl lg:text-5xl"></div>
            </div>
            <div id="scoreA" class="score-num text-5xl font-bold tabular-nums md:text-7xl lg:text-8xl"><%= match && match.currentPoints ? (match.currentPoints.a || 0) : 0 %></div>
          </div>
          <div class="flex items-center gap-4 px-6 py-6 md:px-10 md:py-9">
            <div id="serveB" class="serve-mark opacity-0" aria-hidden="true"></div>
            <div class="min-w-0 flex-1">
              <div id="teamB" class="truncate text-xl font-medium tracking-wide text-sky-400 md:text-3xl lg:text-4xl"><%= match && match.teamB ? match.teamB.name : '' %></div>
              <div id="playersB" class="mt-2 truncate text-2xl font-semibold tracking-wide text-sky-100 md:text-4xl lg:text-5xl"></div>
            </div>
            <div id="scoreB" class="score-num text-5xl font-bold tabular-nums md:text-7xl lg:text-8xl"><%= match && match.currentPoints ? (match.currentPoints.b || 0) : 0 %></div>
          </div>
        </div>
        <div class="border-t border-slate-800/80 px-6 py-4 text-center md:px-10">
          <p class="text-xs text-slate-500">大比分</p>
          <p id="gamesLine" class="mt-1 font-mono text-lg text-slate-200 md:text-xl"><%= match && typeof gamesLine === 'function' ? gamesLine(match) : '—' %></p>
          <p id="deuce" class="mt-2 hidden text-xl font-bold tracking-widest text-rose-400">DEUCE</p>
        </div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    (function () {
      var eventSlug = <%- JSON.stringify(event.slug) %>;
      var venueSlug = <%- JSON.stringify(venue.slug) %>;
      var eventId = <%- JSON.stringify(eventIdStr) %>;
      var LEAGUE_LABELS = ['男雙', '女雙', '混雙（1）', '混雙（2）', '混雙（3）'];

      function teamName(team) {
        if (!team) return '—';
        return team.name || '—';
      }

      function formatPlayers(arr) {
        return (arr || []).map(function (n) { return String(n || '').trim(); }).filter(Boolean).join(' · ');
      }

      function boardSidePlayers(m, side, idx) {
        var block = m && m.lineupBySide && m.lineupBySide[side];
        if (!block || !block.confirmed || !Array.isArray(block.games) || !block.games[idx]) return [];
        return (block.games[idx].players || []).filter(Boolean);
      }

      /** 當前回合球員：currentLineup 優先，否則已確認排陣；回合 = completedGames.length */
      function currentRoundInfo(m) {
        if (!m || m.matchFormat !== 'leagueFive') {
          return { label: '', playersA: '', playersB: '', idx: -1 };
        }
        var idx = (m.completedGames || []).length;
        var curA = ((m.currentLineup && m.currentLineup.playersA) || []).filter(Boolean);
        var curB = ((m.currentLineup && m.currentLineup.playersB) || []).filter(Boolean);
        var a = curA.length ? curA : boardSidePlayers(m, 'a', idx);
        var b = curB.length ? curB : boardSidePlayers(m, 'b', idx);
        return {
          idx: idx,
          label: LEAGUE_LABELS[idx] || '',
          playersA: formatPlayers(a),
          playersB: formatPlayers(b),
        };
      }

      function gamesText(m) {
        if (!m) return '—';
        if (m.matchFormat === 'leagueFive') {
          var bits = (m.completedGames || []).map(function (g, i) {
            return (g.label || LEAGUE_LABELS[i] || '') + ' ' + g.a + '-' + g.b;
          });
          var ca = (m.currentPoints && m.currentPoints.a) || 0;
          var cb = (m.currentPoints && m.currentPoints.b) || 0;
          var totA = 0, totB = 0;
          (m.completedGames || []).forEach(function (g) { totA += g.a || 0; totB += g.b || 0; });
          totA += ca; totB += cb;
          var info = currentRoundInfo(m);
          if (info.label) bits.push(info.label + ' [' + ca + '-' + cb + ']');
          return totA + ' : ' + totB + '｜' + bits.filter(Boolean).join(' · ');
        }
        if (!m.completedGames || !m.completedGames.length) return '—';
        return m.completedGames.map(function (g) { return g.a + '-' + g.b; }).join(' · ');
      }

      function isDeuce(a, b) {
        return a >= 14 && b >= 14 && a === b;
      }

      function render(match) {
        var idle = document.getElementById('idle');
        var active = document.getElementById('active');
        var roundEl = document.getElementById('roundLabel');
        if (!match || match.status !== 'live') {
          idle.classList.remove('hidden');
          active.classList.add('hidden');
          roundEl.classList.add('hidden');
          roundEl.textContent = '';
          return;
        }
        idle.classList.add('hidden');
        active.classList.remove('hidden');
        document.getElementById('teamA').textContent = teamName(match.teamA);
        document.getElementById('teamB').textContent = teamName(match.teamB);
        var ca = (match.currentPoints && match.currentPoints.a) || 0;
        var cb = (match.currentPoints && match.currentPoints.b) || 0;
        document.getElementById('scoreA').textContent = ca;
        document.getElementById('scoreB').textContent = cb;
        document.getElementById('serveA').style.opacity = match.serving === 'a' ? '1' : '0';
        document.getElementById('serveB').style.opacity = match.serving === 'b' ? '1' : '0';
        document.getElementById('gamesLine').textContent = gamesText(match);

        var info = currentRoundInfo(match);
        var playersA = document.getElementById('playersA');
        var playersB = document.getElementById('playersB');
        if (match.matchFormat === 'leagueFive') {
          playersA.textContent = info.playersA || '（未排陣）';
          playersB.textContent = info.playersB || '（未排陣）';
          playersA.classList.toggle('opacity-40', !info.playersA);
          playersB.classList.toggle('opacity-40', !info.playersB);
          if (info.label) {
            roundEl.textContent = '現正：' + info.label;
            roundEl.classList.remove('hidden');
          } else {
            roundEl.classList.add('hidden');
          }
        } else {
          playersA.textContent = '';
          playersB.textContent = '';
          roundEl.classList.add('hidden');
        }

        var deuce = document.getElementById('deuce');
        if (match.matchFormat !== 'leagueFive' && isDeuce(ca, cb)) deuce.classList.remove('hidden');
        else deuce.classList.add('hidden');
      }

      var socket = io({ transports: ['websocket', 'polling'] });
      socket.emit('join', { eventId: eventId, court: { eventId: eventId, venueSlug: venueSlug } });
      socket.on('court:update', function (payload) {
        render(payload && payload.match);
      });

      fetch('/api/public/' + encodeURIComponent(eventSlug) + '/court/' + encodeURIComponent(venueSlug) + '/state', {
        headers: { Accept: 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (data) { render(data.match); })
        .catch(function () {});

      <% if (match) { %>
      render(<%- JSON.stringify(match) %>);
      <% } %>
    })();
  </script>
</body>
